# ---- Project: datasets (several GB, never commit) ----
# Anchored to repo root so it does NOT match the src/data/ source package.
# Use /data/* (not /data/) so the README/.gitkeep negations can re-include
# files (git cannot re-include a file under a fully-excluded directory).
/data/*
!/data/.gitkeep
!/data/README.md

# ---- Project: model weights & artifacts ----
*.pt
*.onnx
*.engine
*.trt
*.plan
/weights/*
!/weights/README.md
/runs/
/outputs/
/artifacts/
/mlruns/
*.cache

# ---- Project: calibration / temp ----
calibration/
tmp/
*.log

# ---- ONNX external-data artifacts (UUID .data dumps) ----
*.data

# ---- Secrets ----
.env
*.secret
secrets.yaml
